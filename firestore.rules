rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── pharmacy_tph collection ──────────────────────────────────────
    // ครอบคลุม documents ทั้งหมดที่แอปใช้งาน:
    // suggestions, adr_records, clinic_data,
    // wt_stat, wt_cart, wt_stat_pending, wt_cart_pending,
    // er_records, hosxp_records, hosxp_denom, expiry_tracker, dm_visits, dm_patients,
    // insurance_monthly, insurance_province, insurance_herb_rx, insurance_audit (ตัวชี้วัดงานประกัน — สคริปต์ Hospital Tasks/insurance-sync)
    // insurance_audit_reviews, insurance_audit_docs (ผลตรวจ/เอกสารแนวทางเคลม จากหน้า insurance-audit.html)
    // insurance_smt (รายการโอนเงิน สปสช. จาก smt.nhso.go.th — สคริปต์ insurance-sync)
    // me_rca (RCA/CAPA ของ ME — หน้า ME_Dashboard.html)
    // staff_registry, staff_requests (ทะเบียนเจ้าหน้าที่ คปสอ. + คำขอจากฟอร์มสาธารณะ staff-update.html)
    // vaccine_epi (งานเบิกวัคซีน EPI / VMI อภ. — หน้า vaccine-epi.html)
    // annual_docs (คำสั่งแต่งตั้ง คบส./วัคซีน, แผน Cold Chain + กำหนดทำรายปี — หน้า annual-docs.html)
    // pharmacy_ha (ตัวชี้วัดงานเภสัชกรรม HA จาก HOSxP — สคริปต์ hosxp-sync/pharmacy_ha_sync.py)
    // clinic_YYYY-MM (บันทึกคลินิกแยกเอกสารรายเดือน)
    // mr_meds_NN (ยาเดิมที่พิมพ์สติกเกอร์ใบ MR ตาม HN — หน้า rx-sticker.html, NN = 2 หลักท้ายของ HN)
    match /pharmacy_tph/{docId} {
      // อ่านได้ทุกคน (ข้อมูลภายในโรงพยาบาล ผ่าน PIN แล้ว)
      allow read: if true;

      // เขียนได้เฉพาะ document IDs ที่แอปใช้งานจริง
      allow write: if docId in [
        'suggestions',
        'adr_records',
        'clinic_data',
        'wt_stat',
        'wt_cart',
        'wt_stat_pending',
        'wt_cart_pending',
        'er_records',
        'hosxp_records',
        'hosxp_denom',
        'expiry_tracker',
        'dm_visits',
        'dm_patients',
        'insurance_monthly',
        'insurance_province',
        'insurance_herb_rx',
        'insurance_audit',
        'insurance_audit_reviews',
        'insurance_audit_docs',
        'insurance_smt',
        'pharmacy_ha',
        'me_rca',
        'annual_docs',
        'staff_registry',
        'staff_requests',
        'vaccine_epi'
      ]
      // บันทึกคลินิกแยกเอกสารรายเดือน เช่น clinic_2026-09
      || docId.matches('clinic_[0-9]{4}-[0-9]{2}')
      // ยาเดิมที่พิมพ์ใบ MR แยก 100 เอกสารตาม 2 หลักท้ายของ HN เช่น mr_meds_06
      || docId.matches('mr_meds_[0-9]{2}');
    }

    // ── Deny all other collections / paths ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
